# Supabase — use the SAME project as the other ICL apps (Ignite/Cutbench/JetCalc).
# Copy this file to .env.local and fill in the values from the shared ICL Supabase project.
# These are the browser-exposed anon values (safe for a public client; RLS allows insert-only).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Absolute origin of the deployed quiz (used to build OG image/share URLs).
# Local dev can leave this unset; it falls back to window.location.origin.
VITE_SITE_URL=https://quiz.industrialcuttinglabs.com
